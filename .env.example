ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Local-only: set to 1 to make /admin/enroll and its API routes reachable
# at all — an admin_token session is never sufficient on its own, flag on
# or off. With it on, /admin/enroll still requires re-entering the
# password (a separate, short-lived step-up cookie) before it registers a
# credential. Never takes effect when NODE_ENV=production, regardless of
# this value. Leave unset or 0 otherwise.
ADMIN_ENROLL_OPEN=0
WEBAUTHN_RP_ID=davekanter.com
WEBAUTHN_RP_NAME=Dave Kanter Blog
WEBAUTHN_ORIGIN=https://davekanter.com
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here
RESEND_API_KEY=your_resend_api_key_here
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
